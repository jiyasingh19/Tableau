      <aliases enabled='yes' />
      <column caption='Review Performance Score' datatype='integer' name='[Calculation_1586105698213890]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews] * [Review Scores Rating]' />
      </column>
      <column caption='Price Ctegory' datatype='string' name='[Calculation_1586105698357251]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;300 THEN &quot;LUXURY&quot; ELSEIF  [Price]&gt;150 THEN &quot;Standard&quot; ELSE &quot;BUDGET&quot; END' />
      </column>
      <column caption='Count of Hotels' datatype='integer' name='[Calculation_1586105698660356]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Name])' />
      </column>
      <column caption='Host Status' datatype='string' name='[Calculation_1586105701949445]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since]&lt; TODAY()THEN &quot;Active Host&quot; ELSE &quot;New Host&quot; END' />
      </column>
      <column caption='Review Category' datatype='string' name='[Calculation_1586105702813702]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews]&gt;= 100 THEN &quot;Highly Reviewd&quot; ELSE &quot;Less Reviewd&quot; END' />
      </column>
      <column caption='Price Filter Category' datatype='string' name='[Calculation_1586105704624137]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; [Parameters].[Parameter 1586105703702536] THEN &quot;Above Limit&quot; ELSE &quot;Below Limit&quot; END' />
      </column>
      <column caption='Host_since_new' datatype='date' name='[Calculation_1586105711554572]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since],DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='Review Score Rating ' datatype='integer' name='[Calculation_1586105713913870]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL ([Review Scores Rating (bin)],0)' />
      </column>
      <column datatype='integer' name='[Host Id]' role='dimension' type='ordinal' />
      <column datatype='date' hidden='true' name='[Host Since]' role='dimension' type='ordinal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Zipcode]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
